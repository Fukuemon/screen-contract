{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {},
    "packages/config": {
      "entry": ["tsconfig/*.json"],
      "project": ["**/*.ts"]
    },
    "apps/*": {},
    "e2e": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@screen-contract/server"]
    }
  }
}
