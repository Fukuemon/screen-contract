{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": ["tsconfig/*.json", "vitest/*.ts"],
      "project": ["vitest/**/*.ts"]
    },
    "apps/server": {
      "entry": [
        "src/bin/serve.ts",
        "src/**/*.test.ts",
        "src/**/*.integration.test.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/router.tsx", "src/routes/**/*.tsx", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mcp-bridge": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "e2e": {
      "entry": ["src/**/*.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "scripts/*.mjs"]
    },
    "packages/adapter-browser": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["agent-browser"]
    }
  }
}
