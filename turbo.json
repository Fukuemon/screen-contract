{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["@screen-contract/server#build"],
      "cache": false
    }
  }
}
